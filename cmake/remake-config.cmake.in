@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL REQUIRED)

# Import targets
if(NOT TARGET remake::remake_core)
    include("${CMAKE_CURRENT_LIST_DIR}/remake-targets.cmake")
endif()

# Provide the remake_enable() function
include("${CMAKE_CURRENT_LIST_DIR}/remake.cmake")

# Provide variables
set(REMAKE_EXECUTABLE "${REMAKE_EXECUTABLE}" PARENT_SCOPE)
set(REMAKE_VERSION "${REMAKE_VERSION}" PARENT_SCOPE)