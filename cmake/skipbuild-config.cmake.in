@PACKAGE_INIT@

# skipbuild has zero external dependencies (WinCrypto / POSIX sockets, bundled
# zstd). There is nothing to find_dependency() here.
#
# skipbuild.cmake locates the launcher and defines the skipbuild_enable() and
# skipbuild_enable_target() helper functions.
include("${CMAKE_CURRENT_LIST_DIR}/skipbuild.cmake")

# Provide variables
set(SKIPBUILD_EXECUTABLE "${SKIPBUILD_EXECUTABLE}")
set(SKIPBUILD_VERSION "${SKIPBUILD_VERSION}")
