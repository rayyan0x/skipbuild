@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL REQUIRED)

# Import targets
if(NOT TARGET skipbuild::skipbuild_core)
    include("${CMAKE_CURRENT_LIST_DIR}/skipbuild-targets.cmake")
endif()

# Provide the skipbuild_enable() function
include("${CMAKE_CURRENT_LIST_DIR}/skipbuild.cmake")

# Provide variables
set(SKIPBUILD_EXECUTABLE "${SKIPBUILD_EXECUTABLE}" PARENT_SCOPE)
set(SKIPBUILD_VERSION "${SKIPBUILD_VERSION}" PARENT_SCOPE)